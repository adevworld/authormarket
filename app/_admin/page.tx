"use client";

import { useEffect, useState } from "react";

export default function AdminPage() {
  const [books, setBooks] = useState<any[]>([]);

  const loadBooks = async () => {
    const res = await fetch("/api/admin/books", { cache: "no-store" });
    const data = await res.json();
    setBooks(data);
  };

  useEffect(() => {
    loadBooks();
  }, []);

  return (
    <main
      style={{
        padding: 40,
        background: "#0f172a",
        color: "white",
        minHeight: "100vh",
        fontFamily: "Arial",
      }}
    >
      <h1>Admin Dashboard</h1>
      <p style={{ color: "#94a3b8" }}>Manage submitted books.</p>

      <div style={{ display: "grid", gap: 20, marginTop: 30 }}>
        {books.map((book) => (
          <div
            key={book.id}
            style={{
              display: "flex",
              gap: 20,
              background: "#1e293b",
              padding: 20,
              borderRadius: 12,
              border: "1px solid #334155",
            }}
          >
            {book.image_url && (
              <img
                src={book.image_url}
                alt={book.title}
                style={{
                  width: 100,
                  height: 140,
                  objectFit: "contain",
                  background: "#020617",
                  borderRadius: 8,
                }}
              />
            )}

            <div>
              <h2>{book.title}</h2>
              <p>{book.author}</p>
              <p style={{ color: "#94a3b8" }}>{book.summary}</p>
              <p>
                Featured:{" "}
                <strong style={{ color: book.featured ? "#22c55e" : "#f97316" }}>
                  {book.featured ? "YES" : "NO"}
                </strong>
              </p>
            </div>
          </div>
        ))}
      </div>
    </main>
  );
}